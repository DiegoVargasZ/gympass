+/** Click to Chat addresses a phone number directly, including unsaved contacts. */
+async function openExternalLink(value, open) {
+  let url;
+  try { url = new URL(value); } catch { return; }
+  if (!['https:', 'http:'].includes(url.protocol) || url.username || url.password) return;
+  let phone;
+  if (url.protocol === 'https:') {
+    if (url.hostname === 'wa.me') phone = /^\/([1-9]\d{7,14})\/?$/.exec(url.pathname)?.[1];
+    else if (['api.whatsapp.com', 'web.whatsapp.com'].includes(url.hostname) && url.pathname === '/send')
+      phone = url.searchParams.get('phone');
+  }
+  if (phone && /^[1-9]\d{7,14}$/.test(phone)) {
+    const native = new URL('whatsapp://send');
+    native.searchParams.set('phone', phone);
+    native.searchParams.set('text', url.searchParams.get('text') || '');
+    try {
+      await open(native.href);
+      return;
+    } catch {
+      // Computers without WhatsApp can still open the same number in the browser.
+    }
+  }
+  await open(url.href);
+}
+
+module.exports = { openExternalLink };
