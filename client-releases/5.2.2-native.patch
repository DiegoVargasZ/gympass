+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+const { openExternalLink } = createRequire(import.meta.url)('../desktop/external-links.cjs');
+
+test('WhatsApp de escritorio abre el número sin consultar contactos y conserva el mensaje', async () => {
+  const opened: string[] = [];
+  const text = 'Hola José, tu credencial: https://gympass.site/c/privado?x=1&y=2';
+  await openExternalLink('https://wa.me/59171234567?text=' + encodeURIComponent(text), async (url: string) => { opened.push(url); });
+  const url = new URL(opened[0]);
+  assert.equal(opened.length, 1);
+  assert.equal(url.protocol, 'whatsapp:');
+  assert.equal(url.searchParams.get('phone'), '59171234567');
+  assert.equal(url.searchParams.get('text'), text);
+});
+
+test('sin WhatsApp instalado abre el mismo chat en el navegador', async () => {
+  const opened: string[] = [];
+  const web = 'https://wa.me/59171234567?text=Hola';
+  await openExternalLink(web, async (url: string) => { opened.push(url); if (url.startsWith('whatsapp:')) throw Error('No protocol handler'); });
+  assert.equal(opened.length, 2);
+  assert.equal(opened[1], web);
+});
+
+test('solo convierte enlaces de chat válidos y rechaza protocolos no admitidos', async () => {
+  const opened: string[] = [];
+  const open = async (url: string) => { opened.push(url); };
+  for (const value of ['file:///C:/Windows', 'javascript:alert(1)', 'whatsapp://other', 'https://user:password@wa.me/59171234567'])
+    await openExternalLink(value, open);
+  assert.equal(opened.length, 0);
+  for (const value of ['https://wa.me.example.org/59171234567', 'https://wa.me/0000', 'https://example.org/'])
+    await openExternalLink(value, open);
+  assert.ok(opened.every((url) => url.startsWith('https:')));
+});
