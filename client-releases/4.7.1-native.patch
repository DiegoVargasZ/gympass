@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { find, harness, native } from './component-harness.ts';
+
+test('el lector muestra y oculta la contraseña sin cambiarla ni iniciar sesión', async t => {
+  const h = harness(); t.after(() => h.cleanup());
+  let logins = 0;
+  const dependencies: Record<string, unknown> = { 'react-native': native, './src/ui': { colors: {} }, './src/api': { login: () => { logins++; } } };
+  for (const name of ['expo-camera', 'expo-constants', 'expo-crypto', 'expo-secure-store', 'react-native-safe-area-context', './src/connection', './src/session', './src/pending', './src/poll', './src/ReportScreens', './src/reader-layout', './src/ScanFeedback', './src/access-sounds']) dependencies[name] = {};
+  const { LoginScreen } = h.load('../App.tsx', dependencies, 'LoginScreen');
+  h.render(() => LoginScreen({ onLogin() {} }));
+  let tree = await h.settle();
+  find(tree, e => e.type === 'TextInput' && e.props.accessibilityLabel === 'Contraseña').props.onChangeText('Mi contraseña');
+  tree = await h.settle();
+  for (const hidden of [true, false, true]) {
+    const input = find(tree, e => e.type === 'TextInput' && e.props.accessibilityLabel === 'Contraseña');
+    assert.equal(input.props.secureTextEntry, hidden);
+    assert.equal(input.props.value, 'Mi contraseña');
+    find(tree, e => e.type === 'Pressable' && e.props.accessibilityLabel === (hidden ? 'Mostrar contraseña' : 'Ocultar contraseña')).props.onPress();
+    tree = await h.settle();
+  }
+  assert.equal(logins, 0);
+});
