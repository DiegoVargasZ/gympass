+import { createContext, useContext } from 'react';
+import { themePalettes, type ThemeMode } from '../../lib/theme';
+
+export const NativeTheme = createContext<ThemeMode>('light');
+export function useNativeTheme() {
+  const theme = useContext(NativeTheme);
+  return { theme, colors: themePalettes[theme] };
+}
