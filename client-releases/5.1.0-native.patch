+package local.gympass.controlacceso.mobile
+
+import android.net.ConnectivityManager
+import android.net.Network
+import com.facebook.react.bridge.*
+import com.facebook.react.modules.core.DeviceEventManagerModule
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.URLDecoder
+import java.security.SecureRandom
+import java.util.concurrent.Executors
+
+/** Serves APK assets only. Account data and writes stay in the authenticated native bridge. */
+class GympassOfflineModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private var server: ServerSocket? = null
+  private var address: String? = null
+  private val workers = Executors.newFixedThreadPool(4)
+  private val connections = context.getSystemService(ConnectivityManager::class.java)
+  private val callback = object : ConnectivityManager.NetworkCallback() {
+    override fun onAvailable(network: Network) { changed() }
+    override fun onLost(network: Network) { changed() }
+  }
+  init { connections.registerDefaultNetworkCallback(callback) }
+  override fun getName() = "GympassOffline"
+  private fun changed() {
+    if (context.hasActiveReactInstance()) context.getJSModule(DeviceEventManagerModule.RCTDeviceEventEmitter::class.java).emit("GympassConnectivity", null)
+  }
+  @ReactMethod fun addListener(name: String) {}
+  @ReactMethod fun removeListeners(count: Int) {}
+  @ReactMethod @Synchronized fun start(promise: Promise) {
+    try {
+      if (server == null || server!!.isClosed) {
+        val preferences = context.getSharedPreferences("gympass-offline-assets", 0)
+        val listener = ServerSocket(preferences.getInt("port", 0), 16, InetAddress.getByName("127.0.0.1"))
+        if (!preferences.contains("port")) preferences.edit().putInt("port", listener.localPort).apply()
+        val random = ByteArray(24); SecureRandom().nextBytes(random)
+        val capability = random.joinToString("") { "%02x".format(it.toInt() and 255) }
+        server = listener
+        address = "http://127.0.0.1:${listener.localPort}/$capability/"
+        Thread({
+          while (!listener.isClosed) {
+            try { val client = listener.accept(); workers.execute { serve(client, capability) } }
+            catch (_: Exception) { if (listener.isClosed) break }
+          }
+        }, "GymPASS-assets").apply { isDaemon = true; start() }
+      }
+      promise.resolve(address)
+    } catch (error: Exception) { promise.reject("OFFLINE_ASSETS", "No se pudo abrir la interfaz incluida en la aplicación.", error) }
+  }
+  private fun line(socket: Socket): String {
+    val result = StringBuilder()
+    while (result.length < 8192) {
+      val value = socket.getInputStream().read()
+      if (value == -1 || value == 10) return result.toString().trimEnd('\r')
+      result.append(value.toChar())
+    }
+    throw IllegalArgumentException("Petición demasiado larga")
+  }
+  private fun serve(socket: Socket, capability: String) {
+    socket.use { client ->
+      client.soTimeout = 10000
+      try {
+        val request = line(client).split(' ')
+        require(request.size == 3 && request[0] in listOf("GET", "HEAD"))
+        var headerBytes = 0
+        while (true) { val header = line(client); if (header.isEmpty()) break; headerBytes += header.length; require(headerBytes < 16384) }
+        val raw = URLDecoder.decode(request[1].substringBefore('?'), "UTF-8")
+        require(!raw.contains('\\') && raw.split('/').none { it == "." || it == ".." })
+        var path = raw.removePrefix("/$capability/").trimStart('/')
+        if (raw == "/$capability/" || raw == "/$capability/index.html") path = "index.html"
+        else require(path != "index.html" && !path.endsWith(".html"))
+        require(path.matches(Regex("[A-Za-z0-9_./-]+")))
+        val mime = when (path.substringAfterLast('.')) {
+          "html" -> "text/html; charset=utf-8"
+          "js", "mjs" -> "text/javascript; charset=utf-8"
+          "css" -> "text/css; charset=utf-8"
+          "json" -> "application/json"
+          "svg" -> "image/svg+xml"
+          "png" -> "image/png"
+          "jpg", "jpeg" -> "image/jpeg"
+          "webp" -> "image/webp"
+          "wav" -> "audio/wav"
+          "wasm" -> "application/wasm"
+          else -> "application/octet-stream"
+        }
+        context.assets.open("gympass-web/$path").use { input ->
+          val output = client.getOutputStream()
+          output.write(("HTTP/1.1 200 OK\r\nContent-Type: $mime\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n").toByteArray())
+          if (request[0] == "GET") input.copyTo(output)
+          output.flush()
+        }
+      } catch (_: Exception) {
+        try { client.getOutputStream().write("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".toByteArray()) } catch (_: Exception) {}
+      }
+    }
+  }
+  override fun invalidate() {
+    try { connections.unregisterNetworkCallback(callback) } catch (_: Exception) {}
+    server?.close(); workers.shutdownNow(); super.invalidate()
+  }
+}
