+import { useCallback, useEffect, useRef, useState } from 'react';
+import { ActivityIndicator, AppState, DeviceEventEmitter, NativeModules, Pressable, Text, View } from 'react-native';
+import * as SecureStore from 'expo-secure-store';
+import { LoginScreen } from '../App';
+import GympassApp from './GympassApp';
+import { loadSession, type MobileSession } from './session';
+import { activateReplica, synchronizeReplica, type MobileReplica } from './offline';
+import { logout } from './api';
+import { request as remoteRequest } from './http';
+
+type Ready = { session: MobileSession; replica: MobileReplica; url: string };
+export default function OfflineApp() {
+  const [ready, setReady] = useState<Ready | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [legacy, setLegacy] = useState(false);
+  const [error, setError] = useState('');
+  const working = useRef(false);
+  const mounted = useRef(true);
+  const prepare = useCallback(async (given?: MobileSession) => {
+    if (working.current) return;
+    working.current = true; setLoading(true); setError('');
+    try {
+      const session = given || await loadSession(SecureStore);
+      if (!mounted.current) return;
+      if (!session) { setReady(null); return; }
+      if (session.server_mode !== 'platform' || session.user.role !== 'admin') { setLegacy(true); return; }
+      const replica = await activateReplica(session, false, true);
+      if (!replica?.managementEnabled) throw Error('Actualiza la plataforma y conecta una vez el teléfono para preparar la gestión sin conexión.');
+      const url = await NativeModules.GympassOffline.start();
+      if (!/^http:\/\/127\.0\.0\.1:\d+\/[a-f0-9]{48}\/$/.test(url)) throw Error('La interfaz local no devolvió una dirección válida.');
+      if (mounted.current) setReady({ session, replica, url });
+    } catch (cause) { if (mounted.current) setError((cause as Error).message); }
+    finally { working.current = false; if (mounted.current) setLoading(false); }
+  }, []);
+  useEffect(() => {
+    mounted.current = true; void prepare();
+    return () => { mounted.current = false; };
+  }, [prepare]);
+  useEffect(() => {
+    const reconnect = () => { if (ready || legacy) void synchronizeReplica(); else if (error) void prepare(); };
+    const network = DeviceEventEmitter.addListener('GympassConnectivity', reconnect);
+    const foreground = AppState.addEventListener('change', state => { if (state === 'active') reconnect(); });
+    return () => { network.remove(); foreground.remove(); };
+  }, [ready, legacy, error, prepare]);
+  if (legacy) return <GympassApp />;
+  if (ready) return <GympassApp management={{
+    url: ready.url,
+    request: async (input: string, method: string, body: unknown) => {
+      let path = input;
+      if (path.startsWith('gyms/')) {
+        const prefix = `gyms/${ready.session.gym_id}/`;
+        if (!path.startsWith(prefix)) return { status: 403, data: { error: 'La solicitud pertenece a otro gimnasio.' } };
+        path = path.slice(prefix.length);
+      }
+      if (path === 'auth/logout' && method === 'POST') {
+        setTimeout(() => { void logout(ready.session).catch(() => {}).finally(() => { if (mounted.current) setReady(null); }); }, 0);
+        return { data: { ok: true } };
+      }
+      if (path.startsWith('platform/') || path.startsWith('sync/') || path.startsWith('backups')) {
+        try {
+          return { data: await remoteRequest(ready.session.server, path.startsWith('platform/') ? path : `gyms/${ready.session.gym_id}/${path}`, method, body, ready.session.token) };
+        } catch { return { status: 503, data: { error: 'Abre Cuenta y respaldos del servidor para completar esta operación con Internet. Los datos de gestión del teléfono se conservan.' } }; }
+      }
+      return ready.replica.managementRequest(path, method, body);
+    },
+  }} />;
+  if (loading) return <View style={{ flex: 1, justifyContent: 'center', padding: 24, gap: 16 }}><ActivityIndicator /><Text>Preparando la copia de GymPASS…</Text><Text>La primera vinculación descarga los datos con Internet. Después puedes trabajar sin conexión.</Text></View>;
+  if (error) return <View style={{ flex: 1, justifyContent: 'center', padding: 24, gap: 20 }}><Text accessibilityRole="alert">{error}</Text><Pressable accessibilityRole="button" onPress={() => void prepare()}><Text>Reintentar</Text></Pressable><Pressable accessibilityRole="button" onPress={() => setLegacy(true)}><Text>Abrir el lector y conservar sus pendientes</Text></Pressable></View>;
+  return <LoginScreen onLogin={session => void prepare(session)} />;
+}
