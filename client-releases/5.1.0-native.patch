+const { withMainApplication, withDangerousMod, withAndroidManifest } = require('expo/config-plugins');
+const { mkdir, copyFile, cp, access } = require('node:fs/promises');
+const { join } = require('node:path');
+
+module.exports = function withOfflineManagement(config) {
+  config = withAndroidManifest(config, mod => {
+    const manifest = mod.modResults.manifest;
+    manifest['uses-permission'] ||= [];
+    if (!manifest['uses-permission'].some(entry => entry.$['android:name'] === 'android.permission.ACCESS_NETWORK_STATE')) manifest['uses-permission'].push({ $: { 'android:name': 'android.permission.ACCESS_NETWORK_STATE' } });
+    return mod;
+  });
+  config = withMainApplication(config, mod => {
