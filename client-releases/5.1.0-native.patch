+import { gcm } from '@noble/ciphers/aes.js';
+import { utf8ToBytes, bytesToUtf8 } from '@noble/ciphers/utils.js';
+import type { CredentialCodec } from '../../lib/service';
+
+export function decodeBase64(value: string): Uint8Array {
+  const raw = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
+  return Uint8Array.from(raw, c => c.charCodeAt(0));
+}
+export function encodeBase64(bytes: Uint8Array, url = false): string {
+  let value = '';
+  for (let offset = 0; offset < bytes.length; offset += 8192) value += String.fromCharCode(...bytes.subarray(offset, offset + 8192));
+  const encoded = btoa(value);
+  return url ? encoded.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '') : encoded;
+}
+export function mobileCredentialCodec(key: Uint8Array, keyId: string, random: (bytes: Uint8Array) => Uint8Array): CredentialCodec {
+  if (key.length !== 32 || !/^[a-f0-9]{16}$/.test(keyId)) throw Error('La clave de credenciales no es válida.');
+  return {
+    seal(code, id) {
+      const nonce = random(new Uint8Array(12));
+      const encrypted = gcm(key, nonce, utf8ToBytes(id)).encrypt(utf8ToBytes(code));
+      return ['v1', keyId, encodeBase64(nonce, true), encodeBase64(encrypted.subarray(-16), true), encodeBase64(encrypted.subarray(0, -16), true)].join('.');
+    },
+    open(value, id) {
+      const [version, storedKey, nonce, tag, data] = value.split('.');
+      if (version !== 'v1' || storedKey !== keyId) throw Error('La credencial pertenece a otra clave.');
+      const body = decodeBase64(data), auth = decodeBase64(tag);
+      const encrypted = new Uint8Array(body.length + auth.length);
+      encrypted.set(body); encrypted.set(auth, body.length);
+      return bytesToUtf8(gcm(key, decodeBase64(nonce), utf8ToBytes(id)).decrypt(encrypted));
+    },
+  };
+}
